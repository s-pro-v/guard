# Port serwera (Render ustawia automatycznie zmienną PORT)
PORT=3000

# Główny klucz/hasło dostępu (możesz podać tekst lub hash SHA-256)
# Domyślny hash odpowiada pierwotnemu kluczowi systemowemu
MASTER_KEY=3cdf2dabfe18fb4d0e1f39fc86f836ed20ef0510d0f373b8071417906842bb93

# Sekret kryptograficzny do podpisywania tokenów JWT (zmień na dowolny losowy ciąg znaków)
JWT_SECRET=lks_secure_hub_render_secret_key_change_me_in_production_2026

# Czas ważności tokenu sesji (np. 24h, 7d, 12h)
TOKEN_EXPIRES_IN=24h

# Dozwolone domeny CORS rozdzielone przecinkami (lub * dla wszystkich stron)
ALLOWED_ORIGINS=*
